{
  "manifest_version": 3,
  "name": "DDR Navigation",
  "version": "1.0",
  "description": "Hold Cmd+Shift+. then press an arrow to jump to a saved URL (DDR style).",
  "permissions": ["storage", "tabs", "sessions"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "DDR Nav Config",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/ddr-keys/left.png",
        "assets/ddr-keys/down.png",
        "assets/ddr-keys/up.png",
        "assets/ddr-keys/right.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
