{
  "manifest_version": 3,
  "name": "DDR Nav Receptors",
  "version": "1.1.0",
  "description": "Hold Cmd+Shift+Y then press an arrow to jump to a saved URL (DDR style).",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DDR Nav Config"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/ddr-keys/left.png",
        "assets/ddr-keys/down.png",
        "assets/ddr-keys/up.png",
        "assets/ddr-keys/right.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
